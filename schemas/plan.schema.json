{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canvas report plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_sha256", "metadata", "masthead", "grain", "lenses", "insights", "macro", "theme", "theme_rationale", "creative_direction", "sections", "charts", "methodology", "rule_decisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "eyebrow", "locale"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "eyebrow": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 1}
      }
    },
    "masthead": {"type": "string", "minLength": 1},
    "grain": {"type": "string", "minLength": 1},
    "lenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "rejected"],
      "properties": {
        "selected": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rejected": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "evidence_fields", "limitation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "evidence_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "limitation": {"type": "string", "minLength": 1}
        }
      }
    },
    "macro": {"type": "string", "minLength": 1},
    "theme": {"type": "string", "minLength": 1},
    "theme_rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "signals", "fit_score", "rotation_distance"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fit_score": {"type": "number", "minimum": 0, "maximum": 1},
        "rotation_distance": {"type": "integer", "minimum": 0, "maximum": 3},
        "override": {"type": "boolean"},
        "runner_up": {"type": "string", "minLength": 1},
        "why_not_runner_up": {"type": "string", "minLength": 1}
      }
    },
    "creative_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "hierarchy", "external_tools", "motion_story"],
      "properties": {
        "concept": {"type": "string", "minLength": 1},
        "hierarchy": {"type": "string", "minLength": 1},
        "external_tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "role", "integration", "reason"],
            "properties": {
              "tool": {"enum": ["d3-gallery", "d3", "plotly", "gsap", "motion", "anime"]},
              "role": {"enum": ["chart-form", "data-transform", "state-model", "motion-engine", "illustration"]},
              "integration": {"enum": ["portable-pattern", "vendored-runtime"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "motion_story": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "sequence", "restraint"],
          "properties": {
            "goal": {"type": "string", "minLength": 1},
            "sequence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "restraint": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "lede"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "lede": {"type": "string", "minLength": 1}
        }
      }
    },
    "charts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "section_id", "type", "title", "note", "aria_label", "help", "dataset", "fields", "encodings", "table", "motion"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "section_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "aria_label": {"type": "string", "minLength": 1},
          "help": {"type": "string", "minLength": 1},
          "dataset": {"const": "source"},
          "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "encodings": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
          "table": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columns"],
            "properties": {"columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
          },
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "reason"],
            "properties": {
              "enabled": {"type": "boolean"},
              "reason": {"type": "string", "minLength": 1},
              "kind": {"enum": ["entry"]},
              "trigger": {"enum": ["on-view"]},
              "duration_ms": {"type": "integer", "minimum": 180, "maximum": 1200},
              "easing": {"enum": ["linear", "outCubic", "inOutCubic", "outQuint", "outExpo", "outCirc", "inOutQuint"]},
              "source_tool": {"enum": ["gsap", "motion", "anime"]}
            }
          }
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "formulas", "limitations"],
      "properties": {
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "formulas": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rule_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "decision"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirements": {"type": "object", "additionalProperties": true}
  }
}
