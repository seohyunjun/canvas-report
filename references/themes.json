{
  "schema_version": "1.0",
  "note": "Canonical theme catalogue. assets/select-candidates.py scores subject fit from `subjects`, assets/validate-plan.py rotates on the three axes, and assets/themes.css holds the tokens. Adding a theme means editing all three, plus references/themes.md.",
  "fit": {
    "rule": "fit_score = min(1, matched_subject_keywords / 5) combined with the theme's baseline, rounded to 3dp",
    "signals": "profile column names, the source file name, and requirement text, lowercased and split into word tokens",
    "match": "a keyword matches when a signal token equals it or begins with it (keywords are >= 4 characters)"
  },
